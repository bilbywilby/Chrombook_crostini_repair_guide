{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run EZ_File",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/EZ_File.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "none",
            "problemMatcher": {
                "owner": "python",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1
                }
            }
        },
        {
            "label": "Build EZ_File",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "build",
            "problemMatcher": {
                "owner": "python",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "\\b(?P<severity>error|warning)\\b:\\s+(?P<message>.+)\\s+\\((?P<file>.+):(?P<line>\\d+)\\)",
                    "severity": 1,
                    "message": 2,
                    "file": 3,
                    "line": 4
                }
            }
        },
        {
            "label": "Test EZ_File",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "unittest",
                "discover",
                "-s",
                "${workspaceFolder}/tests/",
                "-p",
                "test_*.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$mocha",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ]
            }
        }
    ]
}