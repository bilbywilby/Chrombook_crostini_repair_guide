{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pipenv install",
      "type": "shell",
      "command": "pipenv install ${input:package} && pip list",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "inputs": [
        {
          "type": "promptString",
          "id": "package",
          "description": "Package name",
          "prompt": "Enter the package name to install",
          "placeHolder": "e.g. requests"
        }
      ]
    }
  ]
}
