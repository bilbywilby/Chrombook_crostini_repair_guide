from flask import Flask, render_template, request, jsonify
import markdown2

app = Flask(__name__)

@app.route('/', methods=['GET'])
def index():
    return render_template('index.html', text='')

@app.route('/parse', methods=['POST'])
def parse():
    text = request.form['content']
    html_content = markdown2.markdown(text)
    headers = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6']
    toc = {'toc_text': '', 'headers': []}

    for line in html_content.split('\n'):
        if any(header in line for header in headers):
            toc['headers'].append(line.strip())

    header_index = 1
    toc_text = '<ol>\n'

    for header in toc['headers']:
        toc_text += f'  <li><a href="#{header_index}">{header.split(" ")[0]}</a></li>\n'
        header_index += 1

    toc_text += '</ol>\n'

    toc['toc_text'] = toc_text

    return render_template('index.html', text=text, toc=toc)

if __name__ == "__main__":
    app.run(debug=True)
    
