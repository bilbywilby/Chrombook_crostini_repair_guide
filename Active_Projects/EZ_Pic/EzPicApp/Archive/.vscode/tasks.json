{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/EzPicApp/EzPicApp.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/EzPicApp/EzPicApp.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/EzPicApp/EzPicApp.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "type": "mix",
            "task": "Print app tree",
            "problemMatcher": [],
            "label": "mix: Print app tree"
        },
        {
            "type": "mix",
            "task": "Format",
            "problemMatcher": [],
            "label": "mix: Format"
        }
    ]
}