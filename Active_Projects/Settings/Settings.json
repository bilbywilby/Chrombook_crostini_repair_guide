{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/property:GenerateFullPaths=true",
                "/t:build",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": "$msCompile",
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "watch",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/property:GenerateFullPaths=true",
                "/t:build",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": {
                "base": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*(?:\\[.*\\])?\\s*Starting\\s+compilation\\s+in\\s+watch\\s+mode\\.\\.\\.",
                    "endsPattern": "^\\s*(?:\\[.*\\])?\\s*Compilation\\s+complete\\.\\s+Watching\\s+for\\s+file\\s+changes\\."
                }
            }
        }
    ]
}
