import os
import subprocess
import tkinter as tk
from tkinter import filedialog, messagebox
from typing import Optional


class Application(tk.Tk):
    """
    A simple Tkinter application for creating an executable file for a Python script file.
    """

    def __init__(self):
        super().__init__()
        self.title("Create Executable From Python Script")
        self.geometry("")
        self.folder_path = ""
        self.create_widgets()

    def create_widgets(self):
        """
        Create the buttons and labels for the GUI.
        """
        self.select_folder_btn = tk.Button(self, text="Select Folder", command=self.select_folder)
        self.select_folder_btn.pack(pady=10)

        self.create_exe_btn = tk.Button(self, text="Create Executable", command=self.create_exe)
        self.create_exe_btn.pack(pady=10)

        self.status_label = tk.Label(self, text="")
        self.status_label.pack(pady=10)

    def select_folder(self):
        """
        Open a dialog box to select a folder.
        """
        self.folder_path = filedialog.askdirectory(title="Select Folder")

    def create_exe(self):
        """
        Create an executable file for the Python script file(s) in the selected folder.
        """
        if not self.folder_path:
            messagebox.showerror("Error", "Please select a folder.")
            return

        # Loop through the folder and find all the Python script files
        py_files = []
        for root, dirs, files in os.walk(self.folder_path):
            for file in files:
                if file.endswith(".py"):
                    py_files.append(os.path.join(root, file))

        if not py_files:
            messagebox.showerror("Error", "No Python scripts found in the selected folder.")
            return

        # Create the executables using pyinstaller for each script file
        for py_file in py_files:
            exe_path = create_exe(py_file)

            if exe_path is None:
                messagebox.showerror("Error", "Failed to create the executable file.")
                return

            # Rename the executable
            exe_name = os.path.splitext(os.path.basename(py_file))[0] + ".exe"
            new_exe_path = os.path.join(os.path.dirname(py_file), exe_name)
            os.rename(exe_path, new_exe_path)

        self.status_label.config(text="Executable(s) created successfully.")

def create_exe(file_path: str) -> Optional[str]:
    """
    Create a Windows executable for a Python script file.
    :param file_path: The path of the Python script file.
    :return: The path of the created executable file, or None if the function call fails.
    """
    if not file_path.endswith(".py"):
        messagebox.showerror("Error", "The selected file must be a Python script with a .py extension.")
        return None

    try:
        subprocess.check_call(["pyinstaller", "--onefile", file_path])
        dir_name = os.path.dirname(file_path)
        dist_folder = os.path.join(dir_name, "dist")
        exe_name = os.path.splitext(os.path.basename(file_path))[0] + ".exe"
        exe_path = os.path.join(dist_folder, exe_name)

        if not os.path.isfile(exe_path):
            messagebox.showerror("Error", f"Could not find {exe_name} in {dist_folder}")
            return None

        return exe_path
    except subprocess.CalledProcessError as e:
        messagebox.showerror("Error", f"Creating the executable failed: {str(e)}")
        return None


if __name__ == "__main__":
    app = Application()
    app.mainloop()