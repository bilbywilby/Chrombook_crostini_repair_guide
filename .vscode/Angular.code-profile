{"name":"Angular","icon":"package","settings":"{\"settings\":\"{\\n    \\\"editor.formatOnPaste\\\": true,\\n    \\\"git.autofetch\\\": true,\\n    \\\"[markdown]\\\":  {\\n        \\\"editor.wordWrap\\\": \\\"on\\\"\\n    },\\n    \\\"[json]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"[jsonc]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    },\\n    \\\"[html]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"[javascript]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"[typescript]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"workbench.iconTheme\\\": \\\"vscode-icons\\\",\\n    \\\"terminal.integrated.commandsToSkipShell\\\": [\\n        \\\"language-julia.interrupt\\\"\\n    ],\\n    \\\"vscode-edge-devtools.webhint\\\": false,\\n    \\\"cmake.configureOnOpen\\\": true,\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\"\\n}\"}","tasks":"{\"tasks\":\"{\\n    // See https://go.microsoft.com/fwlink/?LinkId=733558\\n    // for the documentation about the tasks.json format\\n    \\\"version\\\": \\\"2.0.0\\\",\\n    \\\"tasks\\\": [\\n        {\\n            \\\"label\\\": \\\"build\\\",\\n            \\\"type\\\": \\\"shell\\\",\\n            \\\"command\\\": \\\"msbuild\\\",\\n            \\\"args\\\": [\\n                \\\"/property:GenerateFullPaths=true\\\",\\n                \\\"/t:build\\\",\\n                \\\"/consoleloggerparameters:NoSummary\\\"\\n            ],\\n            \\\"group\\\": \\\"build\\\",\\n            \\\"presentation\\\": {\\n                \\\"reveal\\\": \\\"silent\\\"\\n            },\\n            \\\"problemMatcher\\\": \\\"$msCompile\\\"\\n        }\\n        ],\\n    \\\"controls\\\": {\\n        \\\"classification\\\": \\\"manual\\\",\\n    \\\"version\\\": \\\"2.0.0\\\",\\n    \\\"tasks\\\": [\\n        {\\n            \\\"label\\\": \\\"Run script\\\",\\n            \\\"type\\\": \\\"shell\\\",\\n            \\\"command\\\": \\\"${config:python.pythonPath}\\\",\\n            \\\"args\\\": [\\n                \\\"${file}\\\"\\n            ],\\n            \\\"presentation\\\": {\\n                \\\"echo\\\": true,\\n                \\\"reveal\\\": \\\"silent\\\",\\n                \\\"panel\\\": \\\"shared\\\",\\n                \\\"showReuseMessage\\\": false,\\n                \\\"clear\\\": true\\n            },\\n            \\\"problemMatcher\\\": {\\n                \\\"owner\\\": \\\"python\\\",\\n                \\\"fileLocation\\\": [\\n                    \\\"relative\\\",\\n                    \\\"${workspaceFolder}\\\"\\n                ],\\n                \\\"pattern\\\": {\\n                    \\\"regexp\\\": \\\"\\\\\\\\b(?P<severity>error|warning|message)\\\\\\\\b:\\\\\\\\s+(?P<message>.+)\\\\\\\\s+\\\\\\\\((?P<file>.+):(?P<line>\\\\\\\\d+)\\\\\\\\)\\\",\\n                    \\\"severity\\\": 1,\\n                    \\\"message\\\": 2,\\n                    \\\"file\\\": 3,\\n                    \\\"line\\\": 4\\n                }\\n            }\\n        },\\n        {\\n            \\\"label\\\": \\\"Build package\\\",\\n            \\\"type\\\": \\\"shell\\\",\\n            \\\"command\\\": \\\"${config:python.pythonPath}\\\",\\n            \\\"args\\\": [\\n                \\\"${workspaceFolder}/setup.py\\\",\\n                \\\"sdist\\\",\\n                \\\"bdist_wheel\\\"\\n            ],\\n            \\\"presentation\\\": {\\n                \\\"echo\\\": true,\\n                \\\"reveal\\\": \\\"silent\\\",\\n                \\\"panel\\\": \\\"shared\\\",\\n                \\\"showReuseMessage\\\": false,\\n                \\\"clear\\\": true\\n            },\\n            \\\"problemMatcher\\\": [],\\n            \\\"group\\\": \\\"build\\\"\\n        },\\n        {\\n            \\\"label\\\": \\\"Run unit tests\\\",\\n            \\\"type\\\": \\\"shell\\\",\\n            \\\"command\\\": \\\"${config:python.pythonPath}\\\",\\n            \\\"args\\\": [\\n                \\\"-m\\\",\\n                \\\"unittest\\\",\\n                \\\"-v\\\",\\n                \\\"${workspaceFolder}/tests/*.py\\\"\\n            ],\\n            \\\"presentation\\\": {\\n                \\\"echo\\\": true,\\n                \\\"reveal\\\": \\\"always\\\",\\n                \\\"panel\\\": \\\"shared\\\",\\n                \\\"showReuseMessage\\\": false,\\n                \\\"clear\\\": true\\n            },\\n            \\\"problemMatcher\\\": {\\n                \\\"base\\\": \\\"$mocha-python\\\",\\n                \\\"fileLocation\\\": [\\n                    \\\"relative\\\",\\n                    \\\"${workspaceFolder}\\\"\\n                ]\\n            },\\n            \\\"group\\\": {\\n                \\\"kind\\\": \\\"test\\\",\\n                \\\"isDefault\\\": true\\n            }\\n        },\\n        {\\n            \\\"type\\\": \\\"mix\\\",\\n            \\\"task\\\": \\\"Update all deps\\\",\\n            \\\"problemMatcher\\\": [],\\n            \\\"label\\\": \\\"mix: Update all deps\\\"\\n        },\\n        {\\n            \\\"type\\\": \\\"mix\\\",\\n            \\\"task\\\": \\\"Format\\\",\\n            \\\"problemMatcher\\\": [\\n                \\\"$armcc5\\\"\\n            ],\\n            \\\"label\\\": \\\"mix: Format\\\"\\n        },\\n        {\\n            \\\"label\\\": \\\"build\\\",\\n            \\\"command\\\": \\\"dotnet\\\",\\n            \\\"type\\\": \\\"process\\\",\\n            \\\"args\\\": [\\n                \\\"build\\\",\\n                \\\"${workspaceFolder}/Active_Projects/Create_File_Directoryies/Create_File_Directoryies.sln\\\",\\n                \\\"/property:GenerateFullPaths=true\\\",\\n                \\\"/consoleloggerparameters:NoSummary;ForceNoAlign\\\"\\n            ],\\n            \\\"problemMatcher\\\": \\\"$msCompile\\\"\\n        },\\n        {\\n            \\\"label\\\": \\\"publish\\\",\\n            \\\"command\\\": \\\"dotnet\\\",\\n            \\\"type\\\": \\\"process\\\",\\n            \\\"args\\\": [\\n                \\\"publish\\\",\\n                \\\"${workspaceFolder}/Active_Projects/Create_File_Directoryies/Create_File_Directoryies.sln\\\",\\n                \\\"/property:GenerateFullPaths=true\\\",\\n                \\\"/consoleloggerparameters:NoSummary;ForceNoAlign\\\"\\n            ],\\n            \\\"problemMatcher\\\": \\\"$msCompile\\\"\\n        },\\n        {\\n            \\\"label\\\": \\\"watch\\\",\\n            \\\"command\\\": \\\"dotnet\\\",\\n            \\\"type\\\": \\\"process\\\",\\n            \\\"args\\\": [\\n                \\\"watch\\\",\\n                \\\"run\\\",\\n                \\\"--project\\\",\\n                \\\"${workspaceFolder}/Active_Projects/Create_File_Directoryies/Create_File_Directoryies.sln\\\"\\n            ],\\n            \\\"problemMatcher\\\": \\\"$msCompile\\\"\\n        },\\n        {\\n            \\\"type\\\": \\\"java (build)\\\",\\n            \\\"paths\\\": [\\n                \\\"${workspace}\\\"\\n            ],\\n            \\\"isFullBuild\\\": true,\\n            \\\"group\\\": \\\"build\\\",\\n            \\\"problemMatcher\\\": [],\\n            \\\"label\\\": \\\"java (build): Build Workspace\\\",\\n            \\\"detail\\\": \\\"$(tools) Build all the Java projects in workspace.\\\"\\n        },\\n        {\\n            \\\"type\\\": \\\"docker-build\\\",\\n            \\\"label\\\": \\\"docker-build\\\",\\n            \\\"platform\\\": \\\"node\\\",\\n            \\\"dockerBuild\\\": {\\n                \\\"dockerfile\\\": \\\"${workspaceFolder}/vscode-black-formatter/Dockerfile\\\",\\n                \\\"context\\\": \\\"${workspaceFolder}/vscode-black-formatter\\\",\\n                \\\"pull\\\": true\\n            },\\n            \\\"node\\\": {\\n                \\\"package\\\": \\\"${workspaceFolder}/vscode-black-formatter/package.json\\\"\\n            }\\n        },\\n        {\\n            \\\"type\\\": \\\"docker-run\\\",\\n            \\\"label\\\": \\\"docker-run: release\\\",\\n            \\\"dependsOn\\\": [\\n                \\\"docker-build\\\"\\n            ],\\n            \\\"platform\\\": \\\"node\\\",\\n            \\\"node\\\": {\\n                \\\"package\\\": \\\"${workspaceFolder}/vscode-black-formatter/package.json\\\"\\n            }\\n        },\\n        {\\n            \\\"type\\\": \\\"docker-run\\\",\\n            \\\"label\\\": \\\"docker-run: debug\\\",\\n            \\\"dependsOn\\\": [\\n                \\\"docker-build\\\"\\n            ],\\n            \\\"dockerRun\\\": {\\n                \\\"env\\\": {\\n                    \\\"DEBUG\\\": \\\"*\\\",\\n                    \\\"NODE_ENV\\\": \\\"development\\\"\\n                }\\n            },\\n            \\\"node\\\": {\\n                \\\"package\\\": \\\"${workspaceFolder}/vscode-black-formatter/package.json\\\",\\n                \\\"enableDebugging\\\": true\\n            }\\n        },\\n        {\\n            \\\"type\\\": \\\"dotnet\\\",\\n            \\\"task\\\": \\\"clean\\\",\\n            \\\"group\\\": \\\"clean\\\",\\n            \\\"problemMatcher\\\": [],\\n            \\\"label\\\": \\\"dotnet: clean\\\"\\n        },\\n        {\\n            \\\"type\\\": \\\"julia\\\",\\n            \\\"command\\\": \\\"juliasysimagebuild\\\",\\n            \\\"problemMatcher\\\": [\\n                \\\"\\\"\\n            ],\\n            \\\"group\\\": \\\"build\\\",\\n            \\\"label\\\": \\\"Julia: Build custom sysimage for current environment (experimental)\\\"\\n        },\\n        {\\n            \\\"type\\\": \\\"npm\\\",\\n            \\\"script\\\": \\\"compile\\\",\\n            \\\"path\\\": \\\"vscode-black-formatter\\\",\\n            \\\"group\\\": {\\n                \\\"kind\\\": \\\"build\\\",\\n                \\\"isDefault\\\": true\\n            },\\n            \\\"problemMatcher\\\": [],\\n            \\\"label\\\": \\\"npm: compile - vscode-black-formatter\\\",\\n            \\\"detail\\\": \\\"webpack\\\"\\n        }\\n    ],\\n    \\\"inputs\\\": [\\n        {\\n            \\\"id\\\": \\\"pythonPath\\\",\\n            \\\"type\\\": \\\"command\\\",\\n            \\\"command\\\": \\\"python.setInterpreter\\\",\\n            \\\"args\\\": {\\n                \\\"workspaceFolder\\\": \\\"${workspaceFolder}\\\"\\n            },\\n            \\\"default\\\": \\\"${config:python.pythonPath}\\\",\\n            \\\"description\\\": \\\"Select the Python interpreter to use for this workspace\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"cwd\\\",\\n            \\\"type\\\": \\\"folder\\\",\\n            \\\"default\\\": \\\"${workspaceFolder}\\\",\\n            \\\"description\\\": \\\"The working directory in which the command is executed.\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"envFile\\\",\\n            \\\"type\\\": \\\"file\\\",\\n            \\\"pattern\\\": \\\".env\\\",\\n            \\\"default\\\": \\\"${workspaceFolder}/.env\\\",\\n            \\\"description\\\": \\\"Environment file to load before running the task.\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"buildArgs\\\",\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"multiline\\\": true,\\n            \\\"default\\\": \\\"\\\",\\n            \\\"description\\\": \\\"Additional arguments passed to webpack when building.\\\"\\n        },\\n        {\\n            \\\"id\\\": \\\"sourceMap\\\",\\n            \\\"type\\\": \\\"boolean\\\",\\n            \\\"default\\\": false,\\n            \\\"description\\\": \\\"Enable sourcemaps?\\\"\\n        },\\n        \\n        \\n        {\\n            \\\"id\\\": \\\"showProgress\\\",\\n            \\\"type\\\": \\\"boolean\\\",\\n            \\\"label\\\": \\\"Show Progress\\\",\\n            \\\"default\\\": true,\\n            \\\"description\\\":\\\"Controls whether execution progress should be displayed \\\"id\\\": \\\"webpackConfig\\\",\\n            \\\"type\\\": \\\"pick\\\",\\n            \\\"label\\\": \\\"Choose a Webpack Configuration File\\\",\\n            \\\"items\\\": [\\n                {\\n                    \\\"value\\\": \\\"webpack.config.js\\\",\\n                    \\\"label\\\": \\\"Use custom webpack config\\\"\\n                },\\n                {\\n                    \\\"value\\\": \\\"package.json\\\",\\n                    \\\"label\\\": \\\"Use \\\\\\\"scripts\\\\\\\" field from package.json\\\"\\n                }\\n            ],\\n            \\\"default\\\": \\\"webpack.config.js\\\"\\n        }\\n    ],\\n    \\\"suggests\\\": {\\n        \\\"command\\\": [\\n            \\\"run\\\"\\n        ],\\n        \\\"args\\\": [\\n            \\\"--progress\\\"\\n        ]\\n    }\\n     [\\n        \\\"editor.codeActionsOnSave\\\": {\\n            \\\"source.fixAll.eslint\\\": true\\n        }\\n    ],\\n    \\\"version\\\": \\\"2.0.0\\\"\\n}\"}","snippets":"{\"snippets\":{\"Common user Snippets.code-snippets\":\"{\\n\\t\\\"Tkinter Window Setup\\\": {\\n\\t\\t\\\"prefix\\\": \\\"tkinterwindow\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"from tkinter import *\\\",\\n\\t\\t\\t\\\"from tkinter import ttk\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"root = Tk()\\\",\\n\\t\\t\\t\\\"root.title('${1:Window Title}')\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"# Setup the GUI components here\\\",\\n\\t\\t\\t\\\"$0\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"root.mainloop()\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Setup a basic Tkinter window.\\\"\\n\\t}\\n  \\\"Update Record\\\": {\\n\\t\\t\\\"prefix\\\": \\\"updaterecord\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"cursor.execute('''\\\",\\n\\t\\t\\t\\\"UPDATE ${1:table_name}\\\",\\n\\t\\t\\t\\\"SET ${2:column} = ${3:new_value}\\\",\\n\\t\\t\\t\\\"WHERE ${4:condition}\\\",\\n\\t\\t\\t\\\"''')\\\",\\n\\t\\t\\t\\\"conn.commit()\\\",\\n\\t\\t\\t\\\"$0\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Update a record in a table.\\\"\\n\\t}\\n  \\\"Insert New Record\\\": {\\n\\t\\t\\\"prefix\\\": \\\"insertrecord\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"cursor.execute('''\\\",\\n\\t\\t\\t\\\"INSERT INTO ${1:table_name} (${2:columns})\\\",\\n\\t\\t\\t\\\"VALUES (${3:values})\\\",\\n\\t\\t\\t\\\"''')\\\",\\n\\t\\t\\t\\\"conn.commit()\\\",\\n\\t\\t\\t\\\"$0\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Insert a new record into a table.\\\"\\n\\t}\\n  \\\"Create New Table\\\": {\\n\\t\\t\\\"prefix\\\": \\\"createtable\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"cursor.execute('''\\\",\\n\\t\\t\\t\\\"CREATE TABLE IF NOT EXISTS ${1:table_name} (\\\",\\n\\t\\t\\t\\\"    ${2:column_definitions}\\\",\\n\\t\\t\\t\\\")\\\",\\n\\t\\t\\t\\\"''')\\\",\\n\\t\\t\\t\\\"conn.commit()\\\",\\n\\t\\t\\t\\\"$0\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create a new table in the SQLite database.\\\"\\n\\t}\\n  \\\"Connect to SQLite Database\\\": {\\n\\t\\t\\\"prefix\\\": \\\"connectdb\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"import sqlite3\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"# Connect to the SQLite database or create it if it doesn't exist\\\",\\n\\t\\t\\t\\\"conn = sqlite3.connect('${1:database}.db')\\\",\\n\\t\\t\\t\\\"cursor = conn.cursor()\\\",\\n\\t\\t\\t\\\"$0\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Connect to an SQLite database with Python.\\\"\\n\\t}\\n\\t// Place your global snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and\\n\\t// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope\\n\\t// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is\\n\\t// used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.\\n\\t// Placeholders with the same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"scope\\\": \\\"javascript,typescript\\\",\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n}\",\"python.json\":\"{\\\"Connect to SQLite Database\\\": {\\n  \\\"prefix\\\": \\\"connectdb\\\",\\n  \\\"body\\\": [\\n    \\\"import sqlite3\\\",\\n    \\\"\\\",\\n    \\\"# Connect to the SQLite database or create it if it doesn't exist\\\",\\n    \\\"conn = sqlite3.connect('${1:database}.db')\\\",\\n    \\\"cursor = conn.cursor()\\\",\\n    \\\"$0\\\"\\n  ],\\n  \\\"description\\\": \\\"Connect to an SQLite database with Python.\\\"\\n},\\n\\\"Create New Table\\\": {\\n  \\\"prefix\\\": \\\"createtable\\\",\\n  \\\"body\\\": [\\n    \\\"cursor.execute('''\\\",\\n    \\\"CREATE TABLE IF NOT EXISTS ${1:table_name} (\\\",\\n    \\\"    ${2:column_definitions}\\\",\\n    \\\")\\\",\\n    \\\"''')\\\",\\n    \\\"conn.commit()\\\",\\n    \\\"$0\\\"\\n  ],\\n  \\\"description\\\": \\\"Create a new table in the SQLite database.\\\"\\n},\\n\\\"Insert New Record\\\": {\\n  \\\"prefix\\\": \\\"insertrecord\\\",\\n  \\\"body\\\": [\\n    \\\"cursor.execute('''\\\",\\n    \\\"INSERT INTO ${1:table_name} (${2:columns})\\\",\\n    \\\"VALUES (${3:values})\\\",\\n    \\\"''')\\\",\\n    \\\"conn.commit()\\\",\\n    \\\"$0\\\"\\n  ],\\n  \\\"description\\\": \\\"Insert a new record into a table.\\\"\\n},\\n\\\"Update Record\\\": {\\n  \\\"prefix\\\": \\\"updaterecord\\\",\\n  \\\"body\\\": [\\n    \\\"cursor.execute('''\\\",\\n    \\\"UPDATE ${1:table_name}\\\",\\n    \\\"SET ${2:column} = ${3:new_value}\\\",\\n    \\\"WHERE ${4:condition}\\\",\\n    \\\"''')\\\",\\n    \\\"conn.commit()\\\",\\n    \\\"$0\\\"\\n  ],\\n  \\\"description\\\": \\\"Update a record in a table.\\\"\\n},\\n\\\"Tkinter Window Setup\\\": {\\n  \\\"prefix\\\": \\\"tkinterwindow\\\",\\n  \\\"body\\\": [\\n    \\\"from tkinter import *\\\",\\n    \\\"from tkinter import ttk\\\",\\n    \\\"\\\",\\n    \\\"root = Tk()\\\",\\n    \\\"root.title('${1:Window Title}')\\\",\\n    \\\"\\\",\\n    \\\"# Setup the GUI components here\\\",\\n    \\\"$0\\\",\\n    \\\"\\\",\\n    \\\"root.mainloop()\\\"\\n  ],\\n  \\\"description\\\": \\\"Setup a basic Tkinter window.\\\"\\n}\\n\\n\\n\\t// Place your snippets for python here. Each snippet is defined under a snippet name and has a prefix, body and\\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the\\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"amodio.tsl-problem-matcher\",\"uuid\":\"91954a63-baf9-4e93-a97c-7798c45ca9f7\"},\"displayName\":\"TypeScript + Webpack Problem Matchers\"},{\"identifier\":{\"id\":\"batisteo.vscode-django\",\"uuid\":\"4b41a5a8-170e-4156-b2c0-10efb270abbc\"},\"displayName\":\"Django\"},{\"identifier\":{\"id\":\"blackboxapp.blackbox\",\"uuid\":\"29f905db-7b5e-4c4e-9295-02bf72a065d0\"},\"displayName\":\"Blackbox AI Code Generation, Code Chat, Code Search\"},{\"identifier\":{\"id\":\"cake-build.cake-vscode\",\"uuid\":\"ef045c7e-5053-478e-9d0b-d6ade7bd99a7\"},\"displayName\":\"Cake\"},{\"identifier\":{\"id\":\"christian-kohler.npm-intellisense\",\"uuid\":\"dff6b801-247e-40e9-82e8-8c9b1d19d1b8\"},\"displayName\":\"npm Intellisense\"},{\"identifier\":{\